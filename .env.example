# OpenAI (required for AI assistant / recipe features that call the API)
OPENAI_API_KEY=

# Google Gemini — server only (never NEXT_PUBLIC_*). Create a key at https://aistudio.google.com/apikey
# If you see API_KEY_INVALID, generate a new key and paste it here with no quotes or spaces.
GEMINI_API_KEY=
# Optional model override (default in code: gemini-2.0-flash). Examples: gemini-2.0-flash, gemini-1.5-flash
# GEMINI_MODEL=gemini-1.5-flash

# USDA FoodData Central (optional — server-only food cache hydration)
# https://fdc.nal.usda.gov/api-key-signup.html
USDA_FOODDATA_API_KEY=

# Supabase (optional — demo uses client stub when unset)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# New dashboard name:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy (still supported if publishable is unset):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
#
# Optional — service_role secret from Supabase → Settings → API (server-only, never NEXT_PUBLIC_*).
# Used for: (1) USDA / trusted writes to `food_database`, (2) server fallback when `/api/foods/search` would
# otherwise return no rows due to RLS. Omit if you rely only on anon + session + SQL grants below.
# SUPABASE_SERVICE_ROLE_KEY=
